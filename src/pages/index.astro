---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import FloatingAddButton from '../components/FloatingAddButton.astro';
import BottomSheet from '../components/BottomSheet.astro';
import '../styles/global.css';
---

<Layout title="liminal">
  <div id="app">
    <div class="glow"></div>

    <Header />

    <main>
      <!-- JOURNAL -->
      <section class="view active" id="view-journal">
        <div class="section-title"><span>your entries</span><span id="journalCount"></span></div>
        <div id="journalList" class="journal-grid"></div>
      </section>

      <!-- HABITS -->
      <section class="view" id="view-habits">
        <div class="section-title"><span>today's habits</span><span id="habitDate"></span></div>
        <div id="habitProgress"></div>
        <div id="habitList"></div>
      </section>

      <!-- TASKS -->
      <section class="view" id="view-tasks">
        <div class="daily-focus-wrap">
          <div class="daily-focus-label">daily focus</div>
          <input type="text" id="dailyFocusInput" class="daily-focus-input" placeholder="what's your one big thing today..." />
        </div>
        <div class="day-scroller" id="dayScroller"></div>
        <div id="taskProgress"></div>
        <div id="taskList"></div>
      </section>

      <!-- CALM -->
      <section class="view" id="view-calm">
        <div class="section-title"><span>breathe</span></div>
        <div class="card">
          <div class="breathe-container">
            <div class="breathe-circle" id="breatheCircle"></div>
            <div class="breathe-label" id="breatheLabel">breathe in...</div>
          </div>
        </div>
        <div class="section-title"><span>zen match</span></div>
        <div class="card">
          <div id="zenMatchGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; justify-items: center;"></div>
          <div class="zen-stats">
            <span class="zen-moves" id="zenMoves">0 moves</span>
            <button class="zen-reset" id="zenReset">reset</button>
          </div>
        </div>
      </section>

      <!-- INSIGHTS -->
      <section class="view" id="view-insights">
        <div class="section-title"><span>your progress</span></div>
        <div class="card">
          <div class="stat-grid" id="statGrid"></div>
        </div>
        <div class="section-title"><span>cloud sync</span></div>
        <div class="card">
          <input class="field" id="syncIdInput" placeholder="sync id (blank for new)" />
          <input class="field" type="password" id="syncPassInput" placeholder="encryption password" />
          <div style="display:flex; gap:10px; margin-top:8px;">
            <button class="btn btn-ghost btn-block" id="btnPull">pull</button>
            <button class="btn btn-primary btn-block" id="btnPush">push</button>
          </div>
          <div id="syncStatus" style="font-size:12.5px; margin-top:12px; color:var(--text-dim); text-align:center;"></div>
        </div>
        <div class="section-title"><span>habit streaks</span></div>
        <div id="streakList"></div>
      </section>
    </main>

    <FloatingAddButton />
    <Navigation />
  </div>

  <!-- overlay -->
  <div class="overlay" id="overlay"></div>

  <!-- journal sheet -->
  <BottomSheet id="sheetJournal" title="new entry">
    <textarea class="field" id="journalInput" rows="5" placeholder="what's on your mind today..."></textarea>
    <div class="img-row" id="imgRow">
      <button class="add-img-btn" id="addImgBtn" aria-label="add image">+</button>
    </div>
    <input type="file" id="imgFile" accept="image/*" multiple style="display:none" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelJournal">cancel</button>
      <button class="btn btn-primary" id="saveJournal">save entry</button>
    </div>
  </BottomSheet>

  <!-- habit sheet -->
  <BottomSheet id="sheetHabit" title="new habit">
    <input class="field" id="habitInput" placeholder="e.g. gym, read, drink water..." maxlength="40" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelHabit">cancel</button>
      <button class="btn btn-primary" id="saveHabit">add habit</button>
    </div>
  </BottomSheet>

  <!-- task sheet -->
  <BottomSheet id="sheetTask" title="new task">
    <input class="field" id="taskInput" placeholder="what needs doing..." maxlength="80" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelTask">cancel</button>
      <button class="btn btn-primary" id="saveTask">add task</button>
    </div>
  </BottomSheet>
</Layout>

<script>
  import { saveData, loadData } from '../lib/storage';
  import { encryptData, decryptData } from '../lib/crypto';
  import { pushToCloud, pullFromCloud, updateInCloud } from '../lib/sync';
  import {
    fmtDate, todayKey, uid, escapeHtml,
    calcStreak, last7Dates,
    getGreeting, getFormattedDate, compressImage,
  } from '../lib/utils';
  import type { JournalEntry, Habit, Task, Theme } from '../lib/types';

  /* ══════════════════════════════════════════
     ICONS (inline SVG strings)
     ══════════════════════════════════════════ */

  const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  const trashIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>';
  const trashIconSm = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>';

  /* ══════════════════════════════════════════
     STATE
     ══════════════════════════════════════════ */

  interface AppState {
    journal: JournalEntry[];
    habits: Habit[];
    tasks: Task[];
    dailyFocus: Record<string, string>;
    theme: Theme;
    syncId: string;
  }

  let state: AppState = {
    journal: [],
    habits: [],
    tasks: [],
    dailyFocus: {},
    theme: 'dark',
    syncId: '',
  };

  let selectedDate = fmtDate(new Date());
  const views = ['journal', 'habits', 'tasks', 'insights', 'calm'] as const;

  /* ══════════════════════════════════════════
     HELPERS
     ══════════════════════════════════════════ */

  function relativeTime(ts: number): string {
    const diff = Date.now() - ts;
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days === 1) return 'yesterday';
    if (days < 7) return `${days}d ago`;
    return new Date(ts).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }).toLowerCase();
  }

  function $(id: string): HTMLElement {
    return document.getElementById(id)!;
  }

  /* ══════════════════════════════════════════
     INIT
     ══════════════════════════════════════════ */

  function init(): void {
    state.journal = loadData<JournalEntry[]>('liminal-journal', []);
    state.habits = loadData<Habit[]>('liminal-habits', []).map(h => ({...h, dates: h.dates || []}));
    state.tasks = loadData<Task[]>('liminal-tasks', []).map(t => ({...t, done: t.done || false}));
    state.dailyFocus = loadData<Record<string, string>>('liminal-focus', {}) || {};
    state.theme = loadData<Theme>('liminal-theme', 'dark');
    state.syncId = loadData<string>('liminal-sync', '');

    document.body.setAttribute('data-theme', state.theme);
    updateThemeIcon();
    setGreeting();

    const syncIdInput = $('syncIdInput') as HTMLInputElement;
    if (syncIdInput) syncIdInput.value = state.syncId;

    renderAll();
    initZenMatch();
    initBreathe();
  }

  function setGreeting(): void {
    $('greetTxt').textContent = getGreeting();
    $('dateTxt').textContent = getFormattedDate();
  }

  /* ══════════════════════════════════════════
     THEME TOGGLE
     ══════════════════════════════════════════ */

  function updateThemeIcon(): void {
    const sunEl = $('themeIconSun');
    const moonEl = $('themeIconMoon');
    if (state.theme === 'dark') {
      sunEl.style.display = 'flex';
      moonEl.style.display = 'none';
    } else {
      sunEl.style.display = 'none';
      moonEl.style.display = 'flex';
    }
  }

  $('themeToggle').addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    document.body.setAttribute('data-theme', state.theme);
    updateThemeIcon();
    saveData('liminal-theme', state.theme);
  });

  /* ══════════════════════════════════════════
     TAB NAVIGATION
     ══════════════════════════════════════════ */

  document.querySelectorAll<HTMLButtonElement>('.nav-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nav-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      views.forEach((v) => $('view-' + v).classList.remove('active'));
      $('view-' + btn.dataset.view!).classList.add('active');
      const fabBtn = $('fabBtn') as HTMLButtonElement;
      fabBtn.style.display = (btn.dataset.view === 'insights' || btn.dataset.view === 'calm') ? 'none' : 'flex';
      render(btn.dataset.view!);
    });
  });

  /* ══════════════════════════════════════════
     SHEETS / OVERLAY
     ══════════════════════════════════════════ */

  const overlay = $('overlay');

  function openSheet(id: string): void {
    overlay.classList.add('show');
    $(id).classList.add('show');
  }

  function closeSheets(): void {
    overlay.classList.remove('show');
    document.querySelectorAll('.sheet').forEach((s) => s.classList.remove('show'));
  }

  overlay.addEventListener('click', closeSheets);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSheets();
  });

  $('fabBtn').addEventListener('click', () => {
    const active = document.querySelector<HTMLButtonElement>('.nav-btn.active')!.dataset.view;
    if (active === 'journal') openSheet('sheetJournal');
    else if (active === 'habits') openSheet('sheetHabit');
    else if (active === 'tasks') openSheet('sheetTask');
  });

  /* ══════════════════════════════════════════
     JOURNAL
     ══════════════════════════════════════════ */

  let pendingImages: string[] = [];

  $('addImgBtn').addEventListener('click', () => {
    $('imgFile').click();
  });

  $('imgFile').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.files) return;
    for (let i = 0; i < input.files.length; i++) {
      if (pendingImages.length >= 3) break;
      const b64 = await compressImage(input.files[i]);
      pendingImages.push(b64);
    }
    input.value = '';
    renderPendingImages();
  });

  function renderPendingImages(): void {
    const row = $('imgRow');
    const addBtn = $('addImgBtn');
    row.innerHTML = '';
    pendingImages.forEach((src, idx) => {
      const d = document.createElement('div');
      d.className = 'img-thumb';
      d.innerHTML = `<img src="${src}" alt="attachment" /><div class="rm" data-idx="${idx}">×</div>`;
      row.appendChild(d);
    });
    if (pendingImages.length < 3) row.appendChild(addBtn);
    row.querySelectorAll('.rm').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx!);
        pendingImages.splice(idx, 1);
        renderPendingImages();
      });
    });
  }

  $('cancelJournal').addEventListener('click', () => {
    closeSheets();
    ($('journalInput') as HTMLTextAreaElement).value = '';
    pendingImages = [];
    renderPendingImages();
  });

  $('saveJournal').addEventListener('click', () => {
    const input = $('journalInput') as HTMLTextAreaElement;
    const text = input.value.trim();
    if (!text && pendingImages.length === 0) return;
    state.journal.unshift({ id: uid(), text, images: [...pendingImages], ts: Date.now() });
    saveData('liminal-journal', state.journal);
    closeSheets();
    input.value = '';
    pendingImages = [];
    renderPendingImages();
    render('journal');
    render('insights');
  });

  function renderJournal(): void {
    $('journalCount').textContent = state.journal.length + ' total';
    const list = $('journalList');
    if (state.journal.length === 0) {
      list.innerHTML = '<div class="empty"><span class="empty-emoji">📝</span>nothing here yet — tap + to write your first entry</div>';
      return;
    }
    list.innerHTML = state.journal.map((j) => {
      const timeLabel = relativeTime(j.ts);
      let imgs = '';
      if (j.images && j.images.length > 0) {
        imgs = '<div class="entry-images">' + j.images.map((src) => `<img src="${src}" alt="attachment" loading="lazy" />`).join('') + '</div>';
      }
      return `
        <div class="card" data-journal-id="${j.id}">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="entry-date">${timeLabel}</div>
            <button class="swipe-del js-del-journal" data-id="${j.id}" aria-label="delete">${trashIconSm}</button>
          </div>
          ${j.text ? `<div class="entry-text">${escapeHtml(j.text)}</div>` : ''}
          ${imgs}
        </div>
      `;
    }).join('');

    // Event delegation for delete
    list.querySelectorAll<HTMLButtonElement>('.js-del-journal').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        state.journal = state.journal.filter((x) => x.id !== btn.dataset.id);
        saveData('liminal-journal', state.journal);
        render('journal');
        render('insights');
      });
    });
  }

  /* ══════════════════════════════════════════
     HABITS
     ══════════════════════════════════════════ */

  $('cancelHabit').addEventListener('click', () => closeSheets());
  $('saveHabit').addEventListener('click', () => {
    const input = $('habitInput') as HTMLInputElement;
    const name = input.value.trim();
    if (!name) return;
    state.habits.push({ id: uid(), name, dates: [] });
    saveData('liminal-habits', state.habits);
    closeSheets();
    input.value = '';
    render('habits');
    render('insights');
  });

  function renderHabits(): void {
    const list = $('habitList');
    $('habitDate').textContent = getFormattedDate();

    if (state.habits.length === 0) {
      $('habitProgress').innerHTML = '';
      list.innerHTML = '<div class="empty"><span class="empty-emoji">✨</span>no habits yet — tap + to start tracking something</div>';
      return;
    }

    // Progress bar
    const tk = todayKey();
    const doneCount = state.habits.filter(h => (h.dates || []).includes(tk)).length;
    const total = state.habits.length;
    const pct = Math.round((doneCount / total) * 100);
    $('habitProgress').innerHTML = `
      <div class="card" style="padding: 14px 18px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <span style="font-size:13px; font-weight:700; color:var(--text-dim);">${doneCount} of ${total} done</span>
          <span style="font-size:13px; font-weight:800; background:linear-gradient(135deg, var(--color-accent-amber), var(--color-accent-violet)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">${pct}%</span>
        </div>
        <div class="habit-progress-bar"><div class="habit-progress-fill" style="width:${pct}%"></div></div>
      </div>
    `;

    const dates = last7Dates();
    list.innerHTML = state.habits.map((h) => {
      const streak = calcStreak(h);
      const doneToday = (h.dates || []).includes(tk);
      const dots = dates.map((d, i) =>
        `<div class="dot ${(h.dates || []).includes(d) ? 'on' : ''} ${d === tk ? 'today' : ''}"></div>`
      ).join('');
      const streakText = streak > 0 ? `${streak} day streak 🔥` : 'start today';
      return `
        <div class="card">
          <div class="habit-row">
            <button class="habit-check ${doneToday ? 'done' : ''} js-toggle-habit" data-id="${h.id}" aria-label="toggle habit">
              ${checkIcon}
            </button>
            <div style="flex:1; min-width:0;">
              <div class="habit-name">${escapeHtml(h.name)}</div>
              <div class="habit-streak">${streakText}</div>
            </div>
            <button class="swipe-del js-del-habit" data-id="${h.id}" aria-label="delete">${trashIcon}</button>
          </div>
          <div class="dots">${dots}</div>
        </div>
      `;
    }).join('');

    // Event delegation
    list.querySelectorAll<HTMLButtonElement>('.js-toggle-habit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const h = state.habits.find((x) => x.id === btn.dataset.id);
        if (!h) return;
        const tk2 = todayKey();
        if ((h.dates || []).includes(tk2)) h.dates = h.dates.filter((d) => d !== tk2);
        else h.dates.push(tk2);
        saveData('liminal-habits', state.habits);
        render('habits');
        render('insights');
      });
    });

    list.querySelectorAll<HTMLButtonElement>('.js-del-habit').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        state.habits = state.habits.filter((x) => x.id !== btn.dataset.id);
        saveData('liminal-habits', state.habits);
        render('habits');
        render('insights');
      });
    });
  }

  /* ══════════════════════════════════════════
     TASKS
     ══════════════════════════════════════════ */

  $('cancelTask').addEventListener('click', () => closeSheets());
  $('saveTask').addEventListener('click', () => {
    const input = $('taskInput') as HTMLInputElement;
    const text = input.value.trim();
    if (!text) return;
    state.tasks.push({ id: uid(), text, date: selectedDate, done: false });
    saveData('liminal-tasks', state.tasks);
    closeSheets();
    input.value = '';
    render('tasks');
    render('insights');
  });

  const dailyFocusInput = $('dailyFocusInput') as HTMLInputElement;
  if (dailyFocusInput) {
    dailyFocusInput.addEventListener('input', (e) => {
      state.dailyFocus[selectedDate] = (e.target as HTMLInputElement).value;
      saveData('liminal-focus', state.dailyFocus);
    });
  }

  function renderTasks(): void {
    const list = $('taskList');
    const scroller = $('dayScroller');

    if (dailyFocusInput) {
      dailyFocusInput.value = state.dailyFocus[selectedDate] || '';
    }

    // Day scroller
    const days: Date[] = [];
    for (let i = -3; i <= 3; i++) {
      const d = new Date();
      d.setDate(d.getDate() + i);
      days.push(d);
    }

    scroller.innerHTML = days.map((d) => {
      const key = fmtDate(d);
      const isToday = key === todayKey();
      const dow = isToday ? 'today' : d.toLocaleDateString(undefined, { weekday: 'short' }).toLowerCase();
      return `
        <div class="day-chip ${key === selectedDate ? 'active' : ''} js-select-date" data-key="${key}">
          <div class="dow">${dow}</div>
          <div class="num">${d.getDate()}</div>
        </div>
      `;
    }).join('');

    scroller.querySelectorAll<HTMLDivElement>('.js-select-date').forEach((chip) => {
      chip.addEventListener('click', () => {
        selectedDate = chip.dataset.key!;
        render('tasks');
      });
    });

    // Task progress
    const dayTasks = state.tasks.filter((t) => t.date === selectedDate);
    const doneTasks = dayTasks.filter((t) => t.done).length;
    const taskProgressEl = $('taskProgress');

    if (dayTasks.length > 0) {
      taskProgressEl.innerHTML = `<div class="task-progress">${doneTasks} of ${dayTasks.length} done</div>`;
    } else {
      taskProgressEl.innerHTML = '';
    }

    if (dayTasks.length === 0) {
      list.innerHTML = '<div class="empty"><span class="empty-emoji">📋</span>nothing on the list — tap + to add a task</div>';
      return;
    }

    list.innerHTML = dayTasks.map((t) => `
      <div class="card" style="padding: 14px 18px;">
        <div class="task-row">
          <button class="task-check ${t.done ? 'done' : ''} js-toggle-task" data-id="${t.id}" aria-label="toggle task">
            ${checkIcon}
          </button>
          <div class="task-text ${t.done ? 'done' : ''}">${escapeHtml(t.text)}</div>
          <button class="swipe-del js-del-task" data-id="${t.id}" aria-label="delete">${trashIconSm}</button>
        </div>
      </div>
    `).join('');

    // Event delegation
    list.querySelectorAll<HTMLButtonElement>('.js-toggle-task').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = state.tasks.find((x) => x.id === btn.dataset.id);
        if (!t) return;
        t.done = !t.done;
        saveData('liminal-tasks', state.tasks);
        render('tasks');
        render('insights');
      });
    });

    list.querySelectorAll<HTMLButtonElement>('.js-del-task').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.tasks = state.tasks.filter((x) => x.id !== btn.dataset.id);
        saveData('liminal-tasks', state.tasks);
        render('tasks');
        render('insights');
      });
    });
  }

  /* ══════════════════════════════════════════
     INSIGHTS
     ══════════════════════════════════════════ */

  function renderInsights(): void {
    const statGrid = $('statGrid');
    const bestStreak = Math.max(0, ...state.habits.map((h) => calcStreak(h)));
    const tasksDone = state.tasks.filter((t) => t.done).length;
    statGrid.innerHTML = `
      <div class="stat-item"><div class="stat-num">${state.journal.length}</div><div class="stat-label">entries</div></div>
      <div class="stat-item"><div class="stat-num">${bestStreak}</div><div class="stat-label">best streak</div></div>
      <div class="stat-item"><div class="stat-num">${tasksDone}</div><div class="stat-label">tasks done</div></div>
      <div class="stat-item"><div class="stat-num">${state.habits.length}</div><div class="stat-label">habits tracked</div></div>
    `;

    const sList = $('streakList');
    if (state.habits.length === 0) {
      sList.innerHTML = '<div class="empty"><span class="empty-emoji">🔥</span>add habits to see streaks here</div>';
      return;
    }

    const maxStreak = Math.max(1, ...state.habits.map(h => calcStreak(h)));
    sList.innerHTML = state.habits.map((h) => {
      const streak = calcStreak(h);
      const pct = Math.round((streak / maxStreak) * 100);
      return `
        <div class="card">
          <div class="streak-row">
            <div class="streak-name">${escapeHtml(h.name)}</div>
            <div class="streak-value">${streak} ${streak === 1 ? 'day' : 'days'} 🔥</div>
          </div>
          <div class="streak-bar-wrap"><div class="streak-bar-fill" style="width:${pct}%"></div></div>
        </div>
      `;
    }).join('');
  }

  /* ══════════════════════════════════════════
     SYNC
     ══════════════════════════════════════════ */

  const syncIdInput = $('syncIdInput') as HTMLInputElement;
  const syncPassInput = $('syncPassInput') as HTMLInputElement;
  const syncStatusEl = $('syncStatus');

  function setSyncStatus(text: string, type: 'success' | 'error' | 'loading' | '' = '') {
    const dotClass = type ? `sync-status-dot ${type}` : '';
    const dot = type ? `<span class="${dotClass}"></span>` : '';
    syncStatusEl.innerHTML = `${dot}${text}`;
  }

  $('btnPush')?.addEventListener('click', async () => {
    const pass = syncPassInput.value;
    if (!pass) return setSyncStatus('password required', 'error');
    setSyncStatus('encrypting and pushing...', 'loading');
    try {
      const dataStr = JSON.stringify(state);
      const encrypted = await encryptData(pass, dataStr);

      let sid = syncIdInput.value.trim();
      if (sid) {
        await updateInCloud(sid, encrypted);
      } else {
        sid = await pushToCloud(encrypted);
        syncIdInput.value = sid;
        state.syncId = sid;
        saveData('liminal-sync', sid);
      }
      setSyncStatus(`synced at ${new Date().toLocaleTimeString()}`, 'success');
    } catch (e) {
      console.error(e);
      setSyncStatus('sync failed — check console', 'error');
    }
  });

  $('btnPull')?.addEventListener('click', async () => {
    const sid = syncIdInput.value.trim();
    const pass = syncPassInput.value;
    if (!sid || !pass) return setSyncStatus('sync id and password required', 'error');
    setSyncStatus('pulling and decrypting...', 'loading');
    try {
      const encrypted = await pullFromCloud(sid);
      const decStr = await decryptData(pass, encrypted.ciphertext, encrypted.salt, encrypted.iv);
      const newState = JSON.parse(decStr) as AppState;

      state = { ...state, ...newState };
      saveData('liminal-journal', state.journal);
      saveData('liminal-habits', state.habits);
      saveData('liminal-tasks', state.tasks);
      saveData('liminal-focus', state.dailyFocus);
      saveData('liminal-sync', sid);

      renderAll();
      setSyncStatus(`data restored at ${new Date().toLocaleTimeString()}`, 'success');
    } catch (e) {
      console.error(e);
      setSyncStatus('pull failed (wrong password?)', 'error');
    }
  });

  /* ══════════════════════════════════════════
     ZEN MATCH
     ══════════════════════════════════════════ */

  let zenMoves = 0;

  function initZenMatch() {
    const grid = $('zenMatchGrid');
    if (!grid) return;
    zenMoves = 0;
    updateZenMoves();

    const icons = ['🌿', '💧', '☀️', '🌙', '✨', '🔥', '☁️', '🏔️'];
    const cards = [...icons, ...icons].sort(() => Math.random() - 0.5);

    let flipped: { idx: number; el: HTMLElement; val: string }[] = [];
    let matched = 0;

    grid.innerHTML = '';
    cards.forEach((icon, idx) => {
      const btn = document.createElement('button');
      btn.className = 'zen-card';
      btn.dataset.idx = String(idx);
      btn.dataset.val = icon;
      btn.textContent = '';

      btn.addEventListener('click', () => {
        if (flipped.length === 2 || btn.classList.contains('flipped') || btn.classList.contains('matched')) return;

        btn.textContent = icon;
        btn.classList.add('flipped');
        flipped.push({ idx, el: btn, val: icon });

        if (flipped.length === 2) {
          zenMoves++;
          updateZenMoves();

          setTimeout(() => {
            if (flipped[0].val === flipped[1].val) {
              flipped[0].el.classList.remove('flipped');
              flipped[1].el.classList.remove('flipped');
              flipped[0].el.classList.add('matched');
              flipped[1].el.classList.add('matched');
              matched += 2;
              if (matched === cards.length) {
                setTimeout(() => initZenMatch(), 1200);
              }
            } else {
              flipped[0].el.classList.remove('flipped');
              flipped[1].el.classList.remove('flipped');
              flipped[0].el.textContent = '';
              flipped[1].el.textContent = '';
            }
            flipped = [];
          }, 700);
        }
      });
      grid.appendChild(btn);
    });
  }

  function updateZenMoves() {
    const el = $('zenMoves');
    if (el) el.textContent = `${zenMoves} ${zenMoves === 1 ? 'move' : 'moves'}`;
  }

  $('zenReset')?.addEventListener('click', () => initZenMatch());

  /* ══════════════════════════════════════════
     BREATHE
     ══════════════════════════════════════════ */

  function initBreathe() {
    const circle = $('breatheCircle');
    const label = $('breatheLabel');
    if (!circle || !label) return;

    let expanded = false;
    const phases = ['breathe in...', 'hold...', 'breathe out...', 'hold...'];
    let phaseIdx = 0;

    setInterval(() => {
      if ($('view-calm')?.classList.contains('active')) {
        expanded = !expanded;
        circle.classList.toggle('expanded', expanded);
        label.textContent = phases[phaseIdx % phases.length];
        phaseIdx++;
      }
    }, 4000);
  }

  /* ══════════════════════════════════════════
     RENDER
     ══════════════════════════════════════════ */

  function render(view: string): void {
    if (view === 'journal') renderJournal();
    else if (view === 'habits') renderHabits();
    else if (view === 'tasks') renderTasks();
    else if (view === 'insights') renderInsights();
  }

  function renderAll(): void {
    renderJournal();
    renderHabits();
    renderTasks();
    renderInsights();
  }

  // Start
  init();
</script>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import FloatingAddButton from '../components/FloatingAddButton.astro';
import BottomSheet from '../components/BottomSheet.astro';
import '../styles/global.css';
---

<Layout title="liminal">
  <div id="app">
    <div class="glow"></div>

    <Header />

    <main>
      <!-- JOURNAL -->
      <section class="view active" id="view-journal">
        <div class="section-title"><span>your entries</span><span id="journalCount"></span></div>
        <div id="journalList" class="journal-grid"></div>
      </section>

      <!-- HABITS -->
      <section class="view" id="view-habits">
        <div class="section-title"><span>today</span><span id="habitDate"></span></div>
        <div id="habitList"></div>
      </section>

      <!-- TASKS -->
      <section class="view" id="view-tasks">
        <div class="card" style="margin-bottom: 20px; border-color: var(--border);">
          <div style="font-size:10px; font-weight:700; color:var(--text-faint); margin-bottom:4px; letter-spacing:0.05em;">DAILY FOCUS</div>
          <input type="text" id="dailyFocusInput" placeholder="one big thing for today..." style="width:100%; background:transparent; border:none; color:var(--text); font-size:16px; font-weight:600; outline:none;" />
        </div>
        <div class="day-scroller" id="dayScroller"></div>
        <div id="taskList"></div>
      </section>

      <!-- CALM -->
      <section class="view" id="view-calm">
        <div class="section-title"><span>breathe</span></div>
        <div class="card" style="display:flex; justify-content:center; align-items:center; height: 160px; overflow:hidden;">
          <div id="breatheCircle" style="width: 80px; height: 80px; border-radius: 50%; background: var(--color-accent-red); opacity: 0.15; transition: all 4s ease-in-out; transform: scale(1);"></div>
        </div>
        <div class="section-title"><span>zen match</span></div>
        <div class="card">
          <div id="zenMatchGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; justify-items: center;"></div>
        </div>
      </section>

      <!-- INSIGHTS -->
      <section class="view" id="view-insights">
        <div class="section-title"><span>your progress</span></div>
        <div class="card">
          <div class="stat-grid" id="statGrid"></div>
        </div>
        <div class="section-title"><span>cloud sync</span></div>
        <div class="card">
          <input class="field" id="syncIdInput" placeholder="sync id (blank for new)" />
          <input class="field" type="password" id="syncPassInput" placeholder="encryption password" />
          <div style="display:flex; gap:10px; margin-top:8px;">
            <button class="btn btn-ghost btn-block" id="btnPull">pull</button>
            <button class="btn btn-primary btn-block" id="btnPush">push</button>
          </div>
          <div id="syncStatus" style="font-size:12.5px; margin-top:12px; color:var(--text-dim); text-align:center;"></div>
        </div>
        <div class="section-title"><span>habit streaks</span></div>
        <div id="streakList"></div>
      </section>
    </main>

    <FloatingAddButton />
    <Navigation />
  </div>

  <!-- overlay -->
  <div class="overlay" id="overlay"></div>

  <!-- journal sheet -->
  <BottomSheet id="sheetJournal" title="new entry">
    <textarea class="field" id="journalInput" rows="5" placeholder="what's on your mind today..."></textarea>
    <div class="img-row" id="imgRow">
      <button class="add-img-btn" id="addImgBtn" aria-label="add image">+</button>
    </div>
    <input type="file" id="imgFile" accept="image/*" multiple style="display:none" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelJournal">cancel</button>
      <button class="btn btn-primary" id="saveJournal">save entry</button>
    </div>
  </BottomSheet>

  <!-- habit sheet -->
  <BottomSheet id="sheetHabit" title="new habit">
    <input class="field" id="habitInput" placeholder="e.g. gym, read, drink water..." maxlength="40" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelHabit">cancel</button>
      <button class="btn btn-primary" id="saveHabit">add habit</button>
    </div>
  </BottomSheet>

  <!-- task sheet -->
  <BottomSheet id="sheetTask" title="new task">
    <input class="field" id="taskInput" placeholder="what needs doing..." maxlength="80" />
    <div class="sheet-actions">
      <button class="btn btn-ghost" id="cancelTask">cancel</button>
      <button class="btn btn-primary" id="saveTask">add task</button>
    </div>
  </BottomSheet>
</Layout>

<script>
  import { saveData, loadData } from '../lib/storage';
  import { encryptData, decryptData } from '../lib/crypto';
  import { pushToCloud, pullFromCloud, updateInCloud } from '../lib/sync';
  import {
    fmtDate, todayKey, uid, escapeHtml,
    calcStreak, last7Dates,
    getGreeting, getFormattedDate, compressImage,
  } from '../lib/utils';
  import type { JournalEntry, Habit, Task, Theme, DailyFocus } from '../lib/types';

  const checkIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  const trashIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>';
  const trashIconSm = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>';

  interface AppState {
    journal: JournalEntry[];
    habits: Habit[];
    tasks: Task[];
    dailyFocus: Record<string, string>;
    theme: Theme;
    syncId: string;
  }

  let state: AppState = {
    journal: [],
    habits: [],
    tasks: [],
    dailyFocus: {},
    theme: 'dark',
    syncId: '',
  };

  let selectedDate = fmtDate(new Date());
  const views = ['journal', 'habits', 'tasks', 'insights', 'calm'] as const;

  function init(): void {
    state.journal = loadData<JournalEntry[]>('liminal-journal', []);
    state.habits = loadData<Habit[]>('liminal-habits', []).map(h => ({...h, dates: h.dates || []}));
    state.tasks = loadData<Task[]>('liminal-tasks', []).map(t => ({...t, done: t.done || false}));
    state.dailyFocus = loadData<Record<string, string>>('liminal-focus', {}) || {};
    state.theme = loadData<Theme>('liminal-theme', 'dark');
    state.syncId = loadData<string>('liminal-sync', '');

    document.body.setAttribute('data-theme', state.theme);
    updateThemeIcon();
    setGreeting();
    
    const syncIdInput = document.getElementById('syncIdInput') as HTMLInputElement;
    if (syncIdInput) syncIdInput.value = state.syncId;

    renderAll();
    initZenMatch();
    initBreathe();
}
    state.journal = loadData<JournalEntry[]>('liminal-journal', []);
    state.habits = loadData<Habit[]>('liminal-habits', []);
    state.tasks = loadData<Task[]>('liminal-tasks', []);
    state.dailyFocus = loadData<Record<string, string>>('liminal-focus', {});
    state.theme = loadData<Theme>('liminal-theme', 'dark');
    state.syncId = loadData<string>('liminal-sync', '');

    document.body.setAttribute('data-theme', state.theme);
    updateThemeIcon();
    setGreeting();
    
    const syncIdInput = document.getElementById('syncIdInput') as HTMLInputElement;
    if (syncIdInput) syncIdInput.value = state.syncId;

    renderAll();
    initZenMatch();
    initBreathe();
  }

  function setGreeting(): void {
    document.getElementById('greetTxt')!.textContent = getGreeting();
    document.getElementById('dateTxt')!.textContent = getFormattedDate();
  }

  function updateThemeIcon(): void {
    const sunEl = document.getElementById('themeIconSun')!;
    const moonEl = document.getElementById('themeIconMoon')!;
    if (state.theme === 'dark') {
      sunEl.style.display = 'flex';
      moonEl.style.display = 'none';
    } else {
      sunEl.style.display = 'none';
      moonEl.style.display = 'flex';
    }
  }

  document.getElementById('themeToggle')!.addEventListener('click', () => {
    state.theme = state.theme === 'dark' ? 'light' : 'dark';
    document.body.setAttribute('data-theme', state.theme);
    updateThemeIcon();
    saveData('liminal-theme', state.theme);
  });

  document.querySelectorAll<HTMLButtonElement>('.nav-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nav-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      views.forEach((v) => document.getElementById('view-' + v)!.classList.remove('active'));
      document.getElementById('view-' + btn.dataset.view)!.classList.add('active');
      const fabBtn = document.getElementById('fabBtn') as HTMLButtonElement;
      fabBtn.style.display = (btn.dataset.view === 'insights' || btn.dataset.view === 'calm') ? 'none' : 'flex';
      render(btn.dataset.view!);
    });
  });

  const overlay = document.getElementById('overlay')!;

  function openSheet(id: string): void {
    overlay.classList.add('show');
    document.getElementById(id)!.classList.add('show');
  }

  function closeSheets(): void {
    overlay.classList.remove('show');
    document.querySelectorAll('.sheet').forEach((s) => s.classList.remove('show'));
  }

  overlay.addEventListener('click', closeSheets);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSheets();
  });

  document.getElementById('fabBtn')!.addEventListener('click', () => {
    const active = document.querySelector<HTMLButtonElement>('.nav-btn.active')!.dataset.view;
    if (active === 'journal') openSheet('sheetJournal');
    else if (active === 'habits') openSheet('sheetHabit');
    else if (active === 'tasks') openSheet('sheetTask');
  });

  let pendingImages: string[] = [];

  document.getElementById('addImgBtn')!.addEventListener('click', () => {
    document.getElementById('imgFile')!.click();
  });

  document.getElementById('imgFile')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (!input.files) return;
    for (let i = 0; i < input.files.length; i++) {
      if (pendingImages.length >= 3) break;
      const b64 = await compressImage(input.files[i]);
      pendingImages.push(b64);
    }
    input.value = '';
    renderPendingImages();
  });

  function renderPendingImages(): void {
    const row = document.getElementById('imgRow')!;
    const addBtn = document.getElementById('addImgBtn')!;
    row.innerHTML = '';
    pendingImages.forEach((src, idx) => {
      const d = document.createElement('div');
      d.className = 'img-thumb';
      d.innerHTML = `<img src="${src}" alt="attachment" /><div class="rm" data-idx="${idx}">x</div>`;
      row.appendChild(d);
    });
    if (pendingImages.length < 3) row.appendChild(addBtn);
    row.querySelectorAll('.rm').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx!);
        pendingImages.splice(idx, 1);
        renderPendingImages();
      });
    });
  }

  document.getElementById('cancelJournal')!.addEventListener('click', () => {
    closeSheets();
    (document.getElementById('journalInput') as HTMLTextAreaElement).value = '';
    pendingImages = [];
    renderPendingImages();
  });

  document.getElementById('saveJournal')!.addEventListener('click', () => {
    const input = document.getElementById('journalInput') as HTMLTextAreaElement;
    const text = input.value.trim();
    if (!text && pendingImages.length === 0) return;
    state.journal.unshift({ id: uid(), text, images: [...pendingImages], ts: Date.now() });
    saveData('liminal-journal', state.journal);
    closeSheets();
    input.value = '';
    pendingImages = [];
    renderPendingImages();
    render('journal');
  });

  function delJournal(id: string): void {
    state.journal = state.journal.filter((j) => j.id !== id);
    saveData('liminal-journal', state.journal);
    render('journal');
  }

  document.getElementById('cancelHabit')!.addEventListener('click', () => closeSheets());
  document.getElementById('saveHabit')!.addEventListener('click', () => {
    const input = document.getElementById('habitInput') as HTMLInputElement;
    const name = input.value.trim();
    if (!name) return;
    state.habits.push({ id: uid(), name, dates: [] });
    saveData('liminal-habits', state.habits);
    closeSheets();
    input.value = '';
    render('habits');
  });

  function toggleHabit(id: string, date: string): void {
    const h = state.habits.find((x) => x.id === id);
    if (!h) return;
    if ((h.dates || []).includes(date)) h.dates = h.dates.filter((d) => d !== date);
    else h.dates.push(date);
    saveData('liminal-habits', state.habits);
    render('habits');
  }

  function delHabit(id: string): void {
    state.habits = state.habits.filter((h) => h.id !== id);
    saveData('liminal-habits', state.habits);
    render('habits');
  }

  document.getElementById('cancelTask')!.addEventListener('click', () => closeSheets());
  document.getElementById('saveTask')!.addEventListener('click', () => {
    const input = document.getElementById('taskInput') as HTMLInputElement;
    const text = input.value.trim();
    if (!text) return;
    state.tasks.push({ id: uid(), text, date: selectedDate, done: false });
    saveData('liminal-tasks', state.tasks);
    closeSheets();
    input.value = '';
    render('tasks');
  });

  function toggleTask(id: string): void {
    const t = state.tasks.find((x) => x.id === id);
    if (!t) return;
    t.done = !t.done;
    saveData('liminal-tasks', state.tasks);
    render('tasks');
  }

  function delTask(id: string): void {
    state.tasks = state.tasks.filter((t) => t.id !== id);
    saveData('liminal-tasks', state.tasks);
    render('tasks');
  }
  
  const dailyFocusInput = document.getElementById('dailyFocusInput') as HTMLInputElement;
  if (dailyFocusInput) {
    dailyFocusInput.addEventListener('input', (e) => {
      state.dailyFocus[selectedDate] = (e.target as HTMLInputElement).value;
      saveData('liminal-focus', state.dailyFocus);
    });
  }

  function render(view: string): void {
    if (view === 'journal') renderJournal();
    else if (view === 'habits') renderHabits();
    else if (view === 'tasks') renderTasks();
    else if (view === 'insights') renderInsights();
  }

  function renderAll(): void {
    renderJournal();
    renderHabits();
    renderTasks();
    renderInsights();
  }

  function renderJournal(): void {
    document.getElementById('journalCount')!.textContent = state.journal.length.toString();
    const list = document.getElementById('journalList')!;
    if (state.journal.length === 0) {
      list.innerHTML = '<div class="empty">nothing here yet.</div>';
      return;
    }
    list.innerHTML = state.journal.map((j) => {
      const dt = new Date(j.ts).toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
      let imgs = '';
      if (j.images.length > 0) {
        imgs = '<div class="entry-images">' + j.images.map((src) => `<img src="${src}" alt="img" loading="lazy" />`).join('') + '</div>';
      }
      return `
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="entry-date">${dt}</div>
            <button class="swipe-del" onclick="window.delJournal('${j.id}')" aria-label="delete">${trashIconSm}</button>
          </div>
          ${imgs}
          <div class="entry-text">${escapeHtml(j.text)}</div>
        </div>
      `;
    }).join('');
  }

  function renderHabits(): void {
    const list = document.getElementById('habitList')!;
    document.getElementById('habitDate')!.textContent = getFormattedDate();
    if (state.habits.length === 0) {
      list.innerHTML = '<div class="empty">no habits added.</div>';
      return;
    }
    const dates = last7Dates();
    list.innerHTML = state.habits.map((h) => {
      const streak = calcStreak(h.dates);
      const doneToday = (h.dates || []).includes(todayKey());
      const dots = dates.map((d) => `<div class="dot ${(h.dates || []).includes(d) ? 'on' : ''}"></div>`).join('');
      return `
        <div class="card">
          <div class="habit-row">
            <button class="habit-check ${doneToday ? 'done' : ''}" onclick="window.toggleHabit('${h.id}', '${todayKey()}')" aria-label="toggle habit">
              ${checkIcon}
            </button>
            <div class="habit-name">${escapeHtml(h.name)}</div>
            <div class="habit-streak">${streak} day streak</div>
            <button class="swipe-del" onclick="window.delHabit('${h.id}')" aria-label="delete">${trashIcon}</button>
          </div>
          <div class="dots">${dots}</div>
        </div>
      `;
    }).join('');
  }

  function renderTasks(): void {
    const list = document.getElementById('taskList')!;
    const scroller = document.getElementById('dayScroller')!;
    
    if (dailyFocusInput) {
      dailyFocusInput.value = state.dailyFocus[selectedDate] || '';
    }

    const dates = last7Dates();
    if (dates[dates.length - 1] !== todayKey()) dates.push(todayKey());
    const chips = dates.map((d) => {
      const dt = new Date(d);
      const dow = dt.toLocaleDateString(undefined, { weekday: 'short' });
      const num = dt.getDate();
      return `
        <div class="day-chip ${d === selectedDate ? 'active' : ''}" onclick="window.selectDate('${d}')">
          <div class="dow">${dow}</div>
          <div class="num">${num}</div>
        </div>
      `;
    });
    scroller.innerHTML = chips.join('');

    const dayTasks = state.tasks.filter((t) => t.date === selectedDate);
    if (dayTasks.length === 0) {
      list.innerHTML = '<div class="empty">no tasks for this day.</div>';
      return;
    }
    list.innerHTML = dayTasks.map((t) => `
      <div class="card" style="padding: 14px 18px;">
        <div class="task-row">
          <button class="task-check ${t.done ? 'done' : ''}" onclick="window.toggleTask('${t.id}')">
            ${checkIcon}
          </button>
          <div class="task-text ${t.done ? 'done' : ''}">${escapeHtml(t.text)}</div>
          <button class="swipe-del" onclick="window.delTask('${t.id}')">${trashIconSm}</button>
        </div>
      </div>
    `).join('');
  }

  function renderInsights(): void {
    const statGrid = document.getElementById('statGrid')!;
    const bestStreak = Math.max(0, ...state.habits.map((h) => calcStreak(h.dates)));
    const tasksDone = state.tasks.filter((t) => t.done).length;
    statGrid.innerHTML = `
      <div><div class="stat-num">${state.journal.length}</div><div class="stat-label">entries</div></div>
      <div><div class="stat-num">${bestStreak}</div><div class="stat-label">best streak</div></div>
      <div><div class="stat-num">${tasksDone}</div><div class="stat-label">tasks done</div></div>
      <div><div class="stat-num">${state.habits.length}</div><div class="stat-label">habits tracked</div></div>
    `;

    const sList = document.getElementById('streakList')!;
    if (state.habits.length === 0) {
      sList.innerHTML = '<div class="empty">add habits to see streaks.</div>';
      return;
    }
    sList.innerHTML = state.habits.map((h) => `
      <div class="card" style="display:flex; justify-content:space-between; padding: 14px 18px;">
        <div style="font-weight:600; font-size:14px;">${escapeHtml(h.name)}</div>
        <div style="color:var(--text-dim); font-size:12px;">${calcStreak(h.dates)} days</div>
      </div>
    `).join('');
  }

  // Sync Logic
  const syncIdInput = document.getElementById('syncIdInput') as HTMLInputElement;
  const syncPassInput = document.getElementById('syncPassInput') as HTMLInputElement;
  const syncStatus = document.getElementById('syncStatus') as HTMLDivElement;

  document.getElementById('btnPush')?.addEventListener('click', async () => {
    const pass = syncPassInput.value;
    if (!pass) return syncStatus.textContent = 'password required';
    syncStatus.textContent = 'encrypting and pushing...';
    try {
      const dataStr = JSON.stringify(state);
      const encrypted = await encryptData(pass, dataStr);
      
      let sid = syncIdInput.value.trim();
      if (sid) {
        await updateInCloud(sid, encrypted);
      } else {
        sid = await pushToCloud(encrypted);
        syncIdInput.value = sid;
        state.syncId = sid;
        saveData('liminal-sync', sid);
      }
      syncStatus.textContent = `synced successfully at ${new Date().toLocaleTimeString()}`;
    } catch (e) {
      console.error(e);
      syncStatus.textContent = 'sync failed. check console.';
    }
  });

  document.getElementById('btnPull')?.addEventListener('click', async () => {
    const sid = syncIdInput.value.trim();
    const pass = syncPassInput.value;
    if (!sid || !pass) return syncStatus.textContent = 'sync id and password required';
    syncStatus.textContent = 'pulling and decrypting...';
    try {
      const encrypted = await pullFromCloud(sid);
      const decStr = await decryptData(pass, encrypted.ciphertext, encrypted.salt, encrypted.iv);
      const newState = JSON.parse(decStr) as AppState;
      
      // Merge into state
      state = { ...state, ...newState };
      saveData('liminal-journal', state.journal);
      saveData('liminal-habits', state.habits);
      saveData('liminal-tasks', state.tasks);
      saveData('liminal-focus', state.dailyFocus);
      saveData('liminal-sync', sid);
      
      renderAll();
      syncStatus.textContent = `data restored at ${new Date().toLocaleTimeString()}`;
    } catch (e) {
      console.error(e);
      syncStatus.textContent = 'pull failed (wrong password?)';
    }
  });

  // Zen Match Game
  function initZenMatch() {
    const grid = document.getElementById('zenMatchGrid');
    if (!grid) return;
    const icons = ['🌿','💧','☀️','🌙','✨','🔥','☁️','🏔️'];
    let cards = [...icons, ...icons].sort(() => Math.random() - 0.5);
    
    let flipped: {idx: number, el: HTMLElement, val: string}[] = [];
    let matched = 0;

    grid.innerHTML = '';
    cards.forEach((icon, idx) => {
      const btn = document.createElement('button');
      btn.style.width = '60px';
      btn.style.height = '60px';
      btn.style.borderRadius = '12px';
      btn.style.background = 'var(--glass-strong)';
      btn.style.border = '1px solid var(--border)';
      btn.style.fontSize = '28px';
      btn.style.display = 'flex';
      btn.style.alignItems = 'center';
      btn.style.justifyContent = 'center';
      btn.style.cursor = 'pointer';
      btn.style.color = 'transparent'; // hidden initially
      btn.style.transition = 'all 0.3s var(--ease-smooth)';
      
      btn.addEventListener('click', () => {
        if (flipped.length === 2 || btn.style.color !== 'transparent') return;
        
        btn.style.color = 'var(--text)';
        btn.textContent = icon;
        btn.style.transform = 'scale(0.95)';
        
        flipped.push({idx, el: btn, val: icon});
        
        if (flipped.length === 2) {
          setTimeout(() => {
            if (flipped[0].val === flipped[1].val) {
              flipped[0].el.style.opacity = '0.3';
              flipped[1].el.style.opacity = '0.3';
              flipped[0].el.style.cursor = 'default';
              flipped[1].el.style.cursor = 'default';
              matched += 2;
              if (matched === cards.length) {
                setTimeout(() => initZenMatch(), 1000);
              }
            } else {
              flipped[0].el.style.color = 'transparent';
              flipped[1].el.style.color = 'transparent';
              flipped[0].el.textContent = '';
              flipped[1].el.textContent = '';
            }
            flipped[0].el.style.transform = 'scale(1)';
            flipped[1].el.style.transform = 'scale(1)';
            flipped = [];
          }, 800);
        }
      });
      grid.appendChild(btn);
    });
  }

  // Breathe Animation
  function initBreathe() {
    const circle = document.getElementById('breatheCircle');
    if (!circle) return;
    let expanded = false;
    setInterval(() => {
      if (document.getElementById('view-calm')?.classList.contains('active')) {
        circle.style.transform = expanded ? 'scale(1)' : 'scale(1.8)';
        circle.style.opacity = expanded ? '0.15' : '0.3';
        expanded = !expanded;
      }
    }, 4000);
  }

  // Expose for inline handlers
  (window as any).delJournal = delJournal;
  (window as any).toggleHabit = toggleHabit;
  (window as any).delHabit = delHabit;
  (window as any).toggleTask = toggleTask;
  (window as any).delTask = delTask;
  (window as any).selectDate = (d: string) => {
    selectedDate = d;
    render('tasks');
  };

  // Start
  init();
</script>

